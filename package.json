{
  "name": "monad-rng",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, zero-protocol-fee authenticated block randomness for Monad builders.",
  "license": "MIT",
  "homepage": "https://monad-rng.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ALXxxXNDR/monad-rng.git"
  },
  "bugs": {
    "url": "https://github.com/ALXxxXNDR/monad-rng/issues"
  },
  "imports": {
    "#monad-network": "./app/lib/network.ts"
  },
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "docs:publish": "node scripts/publish-onboarding-docs.mjs",
    "predev": "npm run docs:publish",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "prebuild": "npm run docs:publish",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:vercel": "npm run docs:publish && next build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/randomness-client.test.mjs tests/randomness-demo-safety.test.mjs tests/rendered-html.test.mjs tests/onboarding-docs.test.mjs tests/deployment-attestation.test.mjs tests/monad-testnet-e2e-tool.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vinext --ignore-pattern .wrangler --ignore-pattern work --ignore-pattern contracts/out",
    "contracts:export": "forge build && node scripts/export-contract-artifact.mjs",
    "rpc:smoke": "node scripts/smoke-monad-rpc.mjs",
    "deployment:attest": "node scripts/attest-monad-deployment.mjs",
    "e2e:testnet": "node scripts/monad-testnet-e2e.mjs"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "viem": "^2.55.2"
  },
  "overrides": {
    "postcss": "8.5.14",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.45.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.112.0"
  },
  "type": "module"
}
